# ------------------------------------------------------------
# WasteLink backend environment variables
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file.
# ------------------------------------------------------------

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- MySQL (main relational database) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=wastelink
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_CONNECTION_LIMIT=10

# --- MongoDB (notifications + activity logs) ---
MONGODB_URI=mongodb://127.0.0.1:27017/wastelink

# --- JWT ---
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Google OAuth2 ---
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- RabbitMQ ---
RABBITMQ_URL=amqp://127.0.0.1:5672
RABBITMQ_EXCHANGE=wastelink.events
RABBITMQ_QUEUE=wastelink.notifications
RABBITMQ_ENABLED=true

# --- Email (optional, disabled by default) ---
EMAIL_ENABLED=false
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=you@example.com
EMAIL_PASSWORD=your_email_password
EMAIL_FROM="WasteLink <no-reply@wastelink.local>"
